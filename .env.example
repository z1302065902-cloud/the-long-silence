# ===== Paddle 配置 =====
# 环境：live 或 sandbox。必须显式设置，不要静默默认！
PADDLE_ENV=live

# Paddle 客户端 token（live_ 开头）。用于前端 PricePreview / Checkout。
# 在 Paddle Dashboard → Developer Tools → Authentication 创建。
PADDLE_CLIENT_TOKEN=live_xxx

# Paddle API 密钥（pl_ 开头，仅服务端使用，绝不进客户端）。
# 用于创建客户门户会话等。
PADDLE_API_KEY=pl_xxx

# Paddle webhook 通知签名密钥（与 API key 不同！）。
# 在 Paddle Dashboard → Developer Tools → Notifications 创建 webhook 后获得。
PADDLE_WEBHOOK_SECRET=xxx

# ===== 产品/价格 ID（3 层定价页） =====
# 从 Paddle Dashboard 的 Prices 复制，或用脚本创建后填入。
PADDLE_PRICE_STARTER_MONTH=pri_xxx
PADDLE_PRICE_STARTER_YEAR=pri_xxx
PADDLE_PRICE_PRO_MONTH=pri_xxx
PADDLE_PRICE_PRO_YEAR=pri_xxx
PADDLE_PRICE_ADVANCED_MONTH=pri_xxx
PADDLE_PRICE_ADVANCED_YEAR=pri_xxx

# ===== 数据库（Supabase/Postgres 连接串） =====
# 履约层需要数据库镜像订阅/客户状态。
DATABASE_URL=postgres://user:pass@host:5432/dbname

# ===== 会话 / 认证 =====
# 用于签名用户会话（客户门户需验证登录）。
SESSION_SECRET=change-me-to-a-long-random-string

# ===== 爱发电（Afdian）配置 =====
# user_id：爱发电开发者后台显示（20765df8947211f1b18f52540025c377）
AFDIAN_USER_ID=20765df8947211f1b18f52540025c377
# token：爱发电开发者后台「生成」的 token（切勿泄露、别提交到仓库）
AFDIAN_TOKEN=
# ¥8 完整版方案的 plan_id（在方案管理页获取）
AFDIAN_PLAN_ID=
# 复用上方 DATABASE_URL：webhook 记录已付款订单，玩家订单号自助解锁
